{
  "name": "markdown-atlas",
  "displayName": "Markdown Atlas",
  "description": "给 VS Code 的 Markdown 预览换一套排版 —— 8 套主题、双向滚动同步、KaTeX 公式、代码高亮、自定义样式，导出独立 HTML 与 PDF。",
  "version": "0.4.0",
  "publisher": "decemy",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0B7A61",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Decem-Y/markdown-atlas.git"
  },
  "bugs": {
    "url": "https://github.com/Decem-Y/markdown-atlas/issues"
  },
  "homepage": "https://github.com/Decem-Y/markdown-atlas#readme",
  "pricing": "Free",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "markdown",
    "preview",
    "theme",
    "typography",
    "katex"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onWebviewPanel:markdownAtlas.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownAtlas.showPreview",
        "title": "打开预览",
        "category": "Markdown Atlas",
        "icon": {
          "light": "./media/icon/preview-light.svg",
          "dark": "./media/icon/preview-dark.svg"
        }
      },
      {
        "command": "markdownAtlas.showPreviewToSide",
        "title": "在侧边打开预览",
        "category": "Markdown Atlas",
        "icon": {
          "light": "./media/icon/preview-light.svg",
          "dark": "./media/icon/preview-dark.svg"
        }
      },
      {
        "command": "markdownAtlas.selectTheme",
        "title": "选择预览主题",
        "category": "Markdown Atlas"
      },
      {
        "command": "markdownAtlas.refreshPreview",
        "title": "刷新预览",
        "category": "Markdown Atlas"
      },
      {
        "command": "markdownAtlas.exportHtml",
        "title": "导出为 HTML",
        "category": "Markdown Atlas",
        "icon": "$(save)"
      },
      {
        "command": "markdownAtlas.editCustomCss",
        "title": "编辑自定义 CSS",
        "category": "Markdown Atlas"
      },
      {
        "command": "markdownAtlas.exportPdf",
        "title": "导出为 PDF",
        "category": "Markdown Atlas"
      },
      {
        "command": "markdownAtlas.export",
        "title": "导出…",
        "category": "Markdown Atlas",
        "icon": "$(save)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "markdownAtlas.showPreview",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownAtlas.showPreviewToSide",
          "when": "editorLangId == markdown"
        },
        {
          "command": "markdownAtlas.refreshPreview",
          "when": "editorLangId == markdown || activeWebviewPanelId == markdownAtlas.preview"
        },
        {
          "command": "markdownAtlas.exportHtml",
          "when": "editorLangId == markdown || activeWebviewPanelId == markdownAtlas.preview"
        },
        {
          "command": "markdownAtlas.exportPdf",
          "when": "editorLangId == markdown || activeWebviewPanelId == markdownAtlas.preview"
        },
        {
          "command": "markdownAtlas.export",
          "when": "editorLangId == markdown || activeWebviewPanelId == markdownAtlas.preview"
        }
      ],
      "editor/title": [
        {
          "command": "markdownAtlas.showPreviewToSide",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "markdownAtlas.showPreviewToSide",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownAtlas.showPreview",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        },
        {
          "command": "markdownAtlas.export",
          "when": "resourceLangId == markdown",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownAtlas.showPreviewToSide",
        "key": "ctrl+k a",
        "mac": "cmd+k a",
        "when": "editorLangId == markdown"
      }
    ],
    "configuration": {
      "title": "Markdown Atlas",
      "properties": {
        "markdownAtlas.theme": {
          "type": "string",
          "default": "editor",
          "enum": [
            "editor",
            "wechat",
            "macos",
            "academic",
            "notion",
            "medium",
            "tech-blog",
            "clean-blue"
          ],
          "enumDescriptions": [
            "跟随当前 VS Code 配色主题，明暗自动切换。",
            "微信经典 —— 居中暖色标题，蓝色强调。",
            "macOS 简约 —— 中性灰，留白充足。",
            "学术论文 —— 衬线正文，首行缩进，三线表。",
            "Notion 简洁 —— 扁平无衬线，柔和分隔线。",
            "Medium 编辑 —— 大号衬线正文，宽版心。",
            "科技博客 —— 紧凑无衬线，密而易读。",
            "简约蓝 —— 蓝色强调，商务报告感。"
          ],
          "description": "Markdown Atlas 预览使用的主题。"
        },
        "markdownAtlas.preview.fontSize": {
          "type": "number",
          "default": 16,
          "minimum": 10,
          "maximum": 32,
          "description": "预览正文的基础字号（px）。标题和代码按比例缩放。"
        },
        "markdownAtlas.preview.lineWidth": {
          "type": "number",
          "default": 760,
          "minimum": 360,
          "maximum": 1600,
          "description": "预览中文章栏的最大宽度（px）。"
        },
        "markdownAtlas.preview.scrollPreviewWithEditor": {
          "type": "boolean",
          "default": true,
          "description": "预览跟随编辑器的可见范围滚动。"
        },
        "markdownAtlas.preview.scrollEditorWithPreview": {
          "type": "boolean",
          "default": true,
          "description": "编辑器跟随预览的可见范围滚动。"
        },
        "markdownAtlas.preview.doubleClickToSwitchToEditor": {
          "type": "boolean",
          "default": false,
          "description": "在预览里双击，跳到编辑器中对应的行。默认关闭：双击在网页里的含义是选中一个词，抢掉这个手势会让文字难以复制。工具栏的 ← 按钮不占用手势也能跳回编辑器。"
        },
        "markdownAtlas.preview.showToolbar": {
          "type": "boolean",
          "default": true,
          "description": "显示预览工具栏（主题选择、目录、缩放）。"
        },
        "markdownAtlas.preview.tableDisplay": {
          "type": "string",
          "default": "scroll",
          "enum": [
            "scroll",
            "expand"
          ],
          "enumDescriptions": [
            "宽表格在文章栏内横向滚动。",
            "宽表格完整展开，改为整页横向滚动。"
          ],
          "description": "宽表格的默认显示方式。预览工具栏的切换只作用于那一个预览，不会写回这里。"
        },
        "markdownAtlas.math.enabled": {
          "type": "boolean",
          "default": true,
          "description": "用 KaTeX 渲染 $...$ 与 $$...$$ 公式。"
        },
        "markdownAtlas.preview.frontMatter": {
          "type": "string",
          "default": "hide",
          "enum": [
            "hide",
            "card"
          ],
          "enumDescriptions": [
            "完全隐藏 YAML front matter 块。",
            "把 YAML front matter 渲染成文档顶部的元信息卡片。"
          ],
          "description": "预览中如何显示 YAML front matter。"
        },
        "markdownAtlas.customCss": {
          "type": "string",
          "default": "",
          "editPresentation": "multilineText",
          "markdownDescription": "叠加在当前主题之上的 CSS。每条规则都要以 `.atlas-content` 开头，例如 `.atlas-content h2 { color: #07c160; }`。也可以在预览的样式面板里编辑。"
        },
        "markdownAtlas.export.outputPath": {
          "type": "string",
          "default": "",
          "description": "导出的默认目标位置。绝对路径，或相对于 Markdown 文件的路径。以扩展名结尾的值当作文件名使用（扩展名会被强制改成当前格式），其余当作目录。留空则写在源文件旁边。预览里的导出路径输入框会按次覆盖此设置。"
        },
        "markdownAtlas.export.embedImages": {
          "type": "boolean",
          "default": true,
          "description": "导出 HTML 时把本地图片内联成 data URI，让文件可以独立分发。"
        },
        "markdownAtlas.export.chromePath": {
          "type": "string",
          "default": "",
          "description": "PDF 导出所用的 Chrome / Edge / Chromium 可执行文件路径。留空则自动探测常见安装位置。"
        },
        "markdownAtlas.export.pdf.pageSize": {
          "type": "string",
          "default": "A4",
          "enum": [
            "A4",
            "A3",
            "A5",
            "Letter",
            "Legal",
            "Tabloid"
          ],
          "description": "PDF 导出的页面大小。"
        },
        "markdownAtlas.export.pdf.margin": {
          "type": "string",
          "default": "16mm",
          "description": "PDF 导出的页边距，写成 CSS 长度（例如 16mm、0.6in，或 \"20mm 15mm\"）。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "vsix": "vsce package",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@vscode/markdown-it-katex": "^1.1.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
